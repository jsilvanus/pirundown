{
  "name": "pirundown",
  "version": "0.1.0",
  "packageManager": "pnpm@11.23.0",
  "description": "Deterministic service rundown and cue execution engine with Rundown v2 YAML syntax and varfetch",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "tsx --test tests/**/*.test.ts",
    "cli": "tsx src/cli.ts"
  },
  "bin": {
    "pirundown": "bin/pirundown.mjs"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "varfetch": "^0.3.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3"
  },
  "files": [
    "dist",
    "bin"
  ],
  "pi": {
    "service": "pirundown",
    "displayName": "PiRundown",
    "layer": "Layer 3: Orchestration",
    "port": 3400,
    "ports": {},
    "healthEndpoint": "/health",
    "envPortVar": "PIRUNDOWN_PORT"
  }
}
