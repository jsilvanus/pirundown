# Server configuration
PIRUNDOWN_PORT=3400
PIRUNDOWN_HOST=0.0.0.0
PIRUNDOWN_API_KEY=

# Ecosystem peer service URLs
PIRUNDOWN_PIGATEWAY_URL=http://127.0.0.1:3000
PIRUNDOWN_PICAM_URL=http://127.0.0.1:3102
PIRUNDOWN_PILIGHT_URL=http://127.0.0.1:3107
PIRUNDOWN_PIPROGRAM_URL=http://127.0.0.1:3200

# Gateway SSE subscription
PIRUNDOWN_AUTO_CONNECT_GATEWAY=true

# Optional auto-load rundown file on startup
PIRUNDOWN_DEFAULT_RUNDOWN_PATH=examples/sunday-mass.yaml
